include_guard(GLOBAL)
set(_cmsis_nn_armclang_errno_source "${CMAKE_CURRENT_LIST_DIR}/armclang_errno.c")

# Test-only binding for Arm kernel/math code inside a single-thread GNU harness.
function(cmsis_nn_link_armclang_test_runtime target root)
    if(NOT CMAKE_C_COMPILER_ID STREQUAL "GNU" OR NOT CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "The ACfE test runtime requires a GNU cross-compiled harness.")
    endif()
    get_target_property(_imported ${target} IMPORTED)
    if(NOT _imported)
        message(FATAL_ERROR "The ACfE test runtime requires an imported kernel archive.")
    endif()

    if(CMAKE_SYSTEM_PROCESSOR STREQUAL "cortex-m4")
        set(_math "${root}/lib/armlib/m_wm.l")
        set(_fp "${root}/lib/armlib/fz_wm.l")
        set(_fp_members frnd.o fnaninf.o usenofp.o)
    elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL "cortex-m55")
        set(_math "${root}/lib/armlib/m_wv.l")
        set(_fp "${root}/lib/armlib/fz_wv.l")
        set(_fp_members frnd.o fnaninf.o usenofp.o)
    else()
        message(FATAL_ERROR "The ACfE test runtime supports only cortex-m4 and cortex-m55.")
    endif()
    set(_c "${root}/lib/armlib/c_wu.l")
    foreach(_archive IN ITEMS "${_math}" "${_c}" "${_fp}")
        if(NOT EXISTS "${_archive}")
            message(FATAL_ERROR "Missing ACfE test runtime archive: ${_archive}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_archive}")
    endforeach()

    # Audited closure for CORE's erfcf/floorf/roundf hard-float imports. Linking
    # the whole math archive also exposes base-PCS aliases to GNU VFP callers.
    set(_math_members erfcf.o floorf.o roundf.o expf_i.o fpclassifyf.o funder.o)
    set(_dir "${CMAKE_CURRENT_BINARY_DIR}/armclang-test-runtime")
    file(MAKE_DIRECTORY "${_dir}")
    set(_objects)
    foreach(_member IN ITEMS _rserrno.o ${_math_members} ${_fp_members})
        if(_member STREQUAL "_rserrno.o")
            set(_archive "${_c}")
        elseif(_member IN_LIST _math_members)
            set(_archive "${_math}")
        else()
            set(_archive "${_fp}")
        endif()
        set(_object "${_dir}/${_member}")
        execute_process(COMMAND "${CMAKE_AR}" p "${_archive}" "${_member}"
            OUTPUT_FILE "${_object}" ERROR_VARIABLE _error RESULT_VARIABLE _result)
        file(SIZE "${_object}" _size)
        if(NOT _result EQUAL 0 OR _size EQUAL 0)
            message(FATAL_ERROR "Cannot extract ${_archive}(${_member}): ${_error}")
        endif()
        if(_member MATCHES "^(erfcf|floorf|roundf)[.]o$")
            execute_process(COMMAND "${CMAKE_OBJCOPY}" "--localize-symbol=${CMAKE_MATCH_1}" "${_object}"
                ERROR_VARIABLE _error RESULT_VARIABLE _result)
            if(NOT _result EQUAL 0)
                message(FATAL_ERROR "Cannot isolate ${_member}: ${_error}")
            endif()
        endif()
        list(APPEND _objects "${_object}")
    endforeach()

    # No selected native object may fall through to GNU for a base-PCS call.
    execute_process(COMMAND "${CMAKE_NM}" -g -P ${_objects}
        OUTPUT_VARIABLE _symbols ERROR_VARIABLE _error RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ACfE test runtime symbols: ${_error}")
    endif()
    string(REPLACE "\n" ";" _lines "${_symbols}")
    set(_defined)
    set(_undefined)
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^([^ ]+) ([A-Za-z])([ ]|$)")
            set(_symbol "${CMAKE_MATCH_1}")
            set(_type "${CMAKE_MATCH_2}")
            if(_type STREQUAL "U")
                list(APPEND _undefined "${_symbol}")
            elseif(_type MATCHES "^[TDBRWV]$")
                if(NOT _symbol MATCHES "^_")
                    message(FATAL_ERROR "Unexpected public ACfE math symbol: ${_symbol}")
                endif()
                list(APPEND _defined "${_symbol}")
            endif()
        endif()
    endforeach()
    foreach(_symbol IN LISTS _undefined)
        if(NOT _symbol IN_LIST _defined AND NOT _symbol STREQUAL "__aeabi_errno_addr")
            message(FATAL_ERROR "Unexpected ACfE test runtime dependency: ${_symbol}")
        endif()
    endforeach()

    add_library(cmsis_nn_test_armclang_errno STATIC "${_cmsis_nn_armclang_errno_source}")
    target_compile_options(cmsis_nn_test_armclang_errno PRIVATE
        "-mcpu=${CMAKE_SYSTEM_PROCESSOR}" -mthumb -mfloat-abi=hard)
    if(CMAKE_SYSTEM_PROCESSOR STREQUAL "cortex-m4")
        target_compile_options(cmsis_nn_test_armclang_errno PRIVATE -mfpu=fpv4-sp-d16)
    endif()
    target_link_libraries(${target} INTERFACE ${_objects} cmsis_nn_test_armclang_errno m)
endfunction()
