---
// SPDX-License-Identifier: LicenseRef-Ambiq-Apollo-SDK
/**
 * A whole card that is one link, with no leading disc: an eyebrow, a title, a
 * line about it, a metadata line, and a cue that moves under the pointer.
 *
 * The landing page runs rows of these with no glyph to put in the disc, so the
 * disc is left out of the composition rather than rendered empty. Cards that
 * do carry a glyph use the package part.
 *
 * The link lives on the title and the recipe stretches it over the card, which
 * is why the card itself is not an anchor. The cue sits inside that link so it
 * is part of the same hit area, and it is hidden from assistive technology:
 * the title already says where the card goes.
 *
 * @slot default -- The line of description under the title.
 */
import type { HTMLAttributes } from 'astro/types';
import Card from '@ambiqai/helia-ui/astro/Card';
import CardContent from '@ambiqai/helia-ui/astro/CardContent';
import CardHeader from '@ambiqai/helia-ui/astro/CardHeader';

interface Props extends Omit<HTMLAttributes<'div'>, 'title'> {
  /** Where the card goes. */
  href: string;
  /** The link text, and the card's accessible name. */
  title: string;
  /** Heading level. Pick the one the page outline needs. */
  titleAs?: 'h2' | 'h3' | 'h4';
  /** The label above the title. */
  eyebrow?: string;
  /** One line of metadata under the title, such as a date or a source. */
  meta?: string;
}

const {
  href,
  title,
  titleAs = 'h3',
  eyebrow,
  meta,
  class: className,
  ...rest
} = Astro.props;

const hasLine = Astro.slots.has('default');
---

<Card interactive class:list={['helia-link-card', className]} {...rest}>
  <CardHeader titleAs={titleAs} href={href} eyebrow={eyebrow}>
    <span class="title"
      >{title}<span class="helia-motion-cue" aria-hidden="true">→</span></span
    >
    {meta && <Fragment slot="meta">{meta}</Fragment>}
  </CardHeader>
  {
    hasLine && (
      <CardContent>
        <slot />
      </CardContent>
    )
  }
</Card>

<style>
  .title {
    align-items: baseline;
    display: inline-flex;
    gap: var(--helia-space-2);
  }
</style>
