{
  "name": "heliacore-site",
  "description": "Astro Starlight site for heliaCORE",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "reference": "node scripts/build-reference.mjs",
    "coverage": "node scripts/build-coverage.mjs",
    "predev": "node scripts/build-reference.mjs --if-missing && node scripts/build-coverage.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-reference.mjs && node scripts/build-coverage.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "node scripts/build-reference.mjs --if-missing && node scripts/build-coverage.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@ambiqai/helia-ui": "github:AmbiqAI/helia-ui#v0.1.0-alpha.10",
    "@astrojs/react": "^6.0.2",
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.0.2",
    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.3"
  }
}
